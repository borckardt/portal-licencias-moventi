# Variables de entorno del proyecto (Vercel → Settings → Environment Variables).
# Este archivo es solo documentación — no lo cargues con "vercel env pull > .env"
# y lo commitees; usa `vercel env pull .env.local` (ya ignorado por git) para
# trabajar localmente con `vercel dev`.
#
# IMPORTANTE (ver tareas.md, sección "Environments"): separa los valores de
# Production y Preview en el dashboard de Vercel para GMAIL_* y
# BLOB_READ_WRITE_TOKEN — si no, cada preview deploy de una rama/PR escribe
# sobre los mismos datos de producción y puede mandar correo real.

# Vercel Blob (Storage → Blob → Connect Project la agrega sola)
BLOB_READ_WRITE_TOKEN=

# Gmail API (ver SETUP_GMAIL.md)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=administracion@moventiglobal.com
# Poner en "true" SOLO si de verdad quieres que un Preview deployment mande
# correo real (ver lib/gmail.js). Déjala vacía/ausente en Preview.
ALLOW_PREVIEW_EMAIL=

# Token compartido que el frontend manda en cada llamada a /api/* (también
# vive, a propósito, dentro de app.js — no es un secreto fuerte, ver ese
# archivo). Debe coincidir con PORTAL_API_TOKEN dentro de app.js.
PORTAL_API_TOKEN=

# Secreto para firmar la cookie de sesión del admin (lib/adminSession.js).
# Genera uno fuerte y NO lo reutilices de ningún otro valor público de este
# proyecto (p.ej. nunca uses el mismo valor que PORTAL_API_TOKEN):
#   openssl rand -base64 48
SESSION_SECRET=
