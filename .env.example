# Variables de entorno del portal.
#
# En Vercel: Settings → Environment Variables.
# En AWS (Elastic Beanstalk): Configuración → Actualizaciones, monitoreo y
#   registro → Propiedades del entorno. (App Runner/ECS: variables del servicio.)
# En local: copia este archivo a .env.local (ya ignorado por git) y complétalo.
# Nunca subas .env.local ni pegues estos valores en un chat.

# ---------------------------------------------------------------------------
# Almacenamiento de datos (ver lib/store.js)
# ---------------------------------------------------------------------------
# s3   → Amazon S3 (AWS). file → archivos en ./data (solo local). blob → Vercel.
# Si se deja vacío se elige solo: S3_BUCKET → s3; BLOB_READ_WRITE_TOKEN → blob;
# ninguno → file.
STORAGE_DRIVER=

# Amazon S3 (STORAGE_DRIVER=s3). Bucket PRIVADO. En AWS no pongas access keys:
# dale permisos al rol IAM de la instancia/servicio (ver DEPLOY_AWS.md).
S3_BUCKET=
S3_PREFIX=portal/
AWS_REGION=us-east-1

# Vercel Blob (STORAGE_DRIVER=blob, o para migrar datos a S3 una sola vez).
BLOB_READ_WRITE_TOKEN=

# Carpeta para STORAGE_DRIVER=file (por defecto ./data).
DATA_DIR=

# ---------------------------------------------------------------------------
# Sesión y API
# ---------------------------------------------------------------------------
# Secreto para firmar la cookie de sesión del admin (obligatorio). Genera uno
# nuevo por entorno, en tu terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Token que el frontend manda en cada llamada a /api/*. Opcional: si lo
# defines, debe ser igual a PORTAL_API_TOKEN dentro de app.js.
PORTAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Correo (Gmail por SMTP con contraseña de aplicación, ver lib/gmail.js)
# ---------------------------------------------------------------------------
GMAIL_SENDER_EMAIL=administracion@moventiglobal.com
GMAIL_APP_PASSWORD=

# Puerto del servidor Node (node-server.js). Beanstalk y App Runner lo definen solos.
PORT=8080
